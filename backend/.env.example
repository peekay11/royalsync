# Database (MongoDB Atlas or Local MongoDB)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/royalsync?retryWrites=true&w=majority"
# For local replica set: DATABASE_URL="mongodb://127.0.0.1:27017/royalsync?replicaSet=rs0"

NODE_ENV=development
PORT=5000
AUTH_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_TOKEN=one-time-initial-admin-token
CORS_ORIGINS=https://royalsync-frontend.pages.dev,http://localhost:3000,http://localhost:5173,http://localhost:8082,http://localhost:8085,*
EMAIL_PROVIDER_URL=
SMS_PROVIDER_URL=
STORAGE_ENDPOINT=
PAYMENT_PROVIDER_URL=
INSURER_GATEWAY_URL=
AI_PROVIDER_URL=
