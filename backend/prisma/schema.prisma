generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  status      String   @default("active")
  plan        String   @default("professional")
  createdAt   DateTime @default(now())
  users       User[]
  clients     Client[]
  leads       Lead[]
  applications Application[]
  policies    Policy[]
  claims      Claim[]
  tasks       Task[]
  insurers    TenantInsurer[]
  auditEvents AuditEvent[]
  commissions Commission[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("CLIENT")
  status       String   @default("active")
  firstName    String   @default("")
  lastName     String   @default("")
  idNumber     String?
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client?
  actorEvents  AuditEvent[] @relation("AuditActor")
}

model Client {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  userId             String?  @unique
  user               User?    @relation(fields: [userId], references: [id])
  firstName          String
  lastName           String
  mobile             String
  email              String?
  idNumber           String?
  kycStatus          String   @default("pending")
  riskProfile        String   @default("Unknown")
  assignedAdviserId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  policies           Policy[]
  claims             Claim[]
  goals              Goal[]
  documents          Document[]
  payments           Payment[]
  applications       Application[]
  reminders          Reminder[]
  conversations      Conversation[]
}

model Lead {
  id         String     @id @default(uuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  firstName  String
  lastName   String
  email      String?
  mobile     String?
  interest   String     @default("General Insurance")
  status     String     @default("New")
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  leadNotes  LeadNote[]
}

model Application {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  productType String
  insurerId   String?
  insurer     Insurer? @relation(fields: [insurerId], references: [id])
  premium     Float    @default(0)
  sumAssured  Float    @default(0)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Policy {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  clientId              String
  client                Client   @relation(fields: [clientId], references: [id])
  insurerId             String?
  insurer               Insurer? @relation(fields: [insurerId], references: [id])
  policyNumber          String
  type                  String
  premium               Float
  sumAssured            Float    @default(0)
  status                String   @default("active")
  inceptionDate         DateTime @default(now())
  expiryDate            DateTime?
  createdAt             DateTime @default(now())
  claims                Claim[]
}

model Claim {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  policyId     String?
  policy       Policy?     @relation(fields: [policyId], references: [id])
  reference    String      @unique
  type         String      @default("General")
  status       String      @default("submitted")
  incidentDate DateTime
  description  String
  amount       Float       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  claimNotes   ClaimNote[]
}

model Task {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  title       String
  description String?
  priority    String   @default("normal")
  status      String   @default("open")
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Goal {
  id                    String   @id @default(uuid())
  clientId              String
  client                Client   @relation(fields: [clientId], references: [id])
  name                  String
  targetAmount          Float
  currentAmount         Float    @default(0)
  targetDate            DateTime?
  contributionAmount    Float?
  contributionFrequency String?
  status                String   @default("active")
  createdAt             DateTime @default(now())
}

model Document {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  name        String
  type        String
  url         String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Payment {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  policyId    String?
  amount      Float
  status      String   @default("paid")
  method      String   @default("debit_order")
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
}

model Reminder {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  title       String
  dueDate     DateTime?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Insurer {
  id            String   @id @default(uuid())
  name          String   @unique
  domain        String?
  category      String   @default("short-term")
  status        String   @default("active")
  apiStatus     String   @default("active")
  contactEmail  String?
  createdAt     DateTime @default(now())
  policies      Policy[]
  applications  Application[]
  tenantLinks   TenantInsurer[]
}

model TenantInsurer {
  tenantId   String
  insurerId  String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  insurer    Insurer @relation(fields: [insurerId], references: [id])
  approvedAt DateTime @default(now())
  @@id([tenantId, insurerId])
}

model Commission {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  adviserId  String?
  amount     Float
  type       String   @default("new_business")
  status     String   @default("paid")
  policyId   String?
  month      String
  createdAt  DateTime @default(now())
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorRole   String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  action      String
  resource    String
  resourceId  String?
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String?
  clientId  String?
  title     String
  body      String
  channel   String   @default("in_app")
  status    String   @default("unread")
  createdAt DateTime @default(now())
}

model Template {
  id        String   @id @default(uuid())
  tenantId  String?
  name      String
  type      String
  format    String   @default("communication") // communication | document
  channel   String   @default("email")
  company   String?  // insurer/broker this document template is designed for
  subject   String?  // email subject, or document title for document templates
  body      String   // plain text for comms, HTML (with {{merge}} fields) for documents
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String    @id @default(uuid())
  tenantId  String
  clientId  String
  createdAt DateTime  @default(now())
  client    Client    @relation(fields: [clientId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // 'adviser' | 'client'
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  authorId  String?
  content   String
  createdAt DateTime @default(now())
}

model ClaimNote {
  id        String   @id @default(uuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id])
  authorId  String?
  content   String
  createdAt DateTime @default(now())
}
