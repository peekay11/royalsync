generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  createdAt    DateTime    @default(now())
  roles        UserRole[]
  client       Client?
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  permissions RolePermission[]
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}

model Permission {
  id       String           @id @default(uuid())
  resource String
  action   String
  roles    RolePermission[]
  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model Client {
  id                String     @id @default(uuid())
  userId            String     @unique
  tenantId          String
  firstName         String
  lastName          String
  assignedAdviserId String?
  user              User       @relation(fields: [userId], references: [id])
  addresses         Address[]
  assets            Asset[]
  liabilities       Liability[]
  incomes           Income[]
  expenses          Expense[]
  goals             Goal[]   @relation("GoalOwner")
  participatingIn   GoalParticipant[]
  serviceRequests   ServiceRequest[]
  policies          Policy[]
  reminders         Reminder[]
  claims            Claim[]
  conversations     Conversation[]
}

model Address {
  id             String    @id @default(uuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  line1          String
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  isCurrent      Boolean   @default(true)
}

model Asset {
  id       String  @id @default(uuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id])
  name     String
  value    Float
}

model Liability {
  id       String  @id @default(uuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id])
  name     String
  value    Float
}

model Income {
  id        String  @id @default(uuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  source    String
  amount    Float
  frequency String  // e.g. "MONTHLY", "ANNUALLY"
}

model Expense {
  id        String  @id @default(uuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  category  String
  amount    Float
  frequency String
}

model Goal {
  id                    String     @id @default(uuid())
  tenantId              String
  name                  String
  description           String?
  targetAmount          Float
  currentAmount         Float      @default(0)
  targetDate            DateTime?
  contributionAmount    Float?
  contributionFrequency String?
  status                String     @default("ACTIVE")
  ownerId               String
  owner                 Client     @relation("GoalOwner", fields: [ownerId], references: [id])
  participants          GoalParticipant[]
}

model GoalParticipant {
  goalId   String
  clientId String
  goal     Goal   @relation(fields: [goalId], references: [id])
  client   Client @relation(fields: [clientId], references: [id])
  @@id([goalId, clientId])
}

model ServiceRequest {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String
  type      String
  status    String   @default("SUBMITTED")
  payload   String   // JSON string
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id])
}

model AuditEvent {
  id          String   @id @default(uuid())
  actor       String
  tenantId    String
  action      String
  resource    String
  beforeState String?  // JSON string
  afterState  String?  // JSON string
  createdAt   DateTime @default(now())
}

model Policy {
  id                    String     @id @default(uuid())
  tenantId              String
  clientId              String
  type                  String
  certificateExpiryDate DateTime
  client                Client     @relation(fields: [clientId], references: [id])
  claims                Claim[]
}

model Reminder {
  id                  String    @id @default(uuid())
  tenantId            String
  clientId            String
  relatedEntityType   String
  relatedEntityId     String
  title               String
  triggerDate         DateTime?
  dueDate             DateTime?
  status              String    @default("PENDING")
  completedAt         DateTime?
  client              Client    @relation(fields: [clientId], references: [id])
}

model Claim {
  id           String       @id @default(uuid())
  tenantId     String
  clientId     String
  policyId     String
  status       String       @default("SUBMITTED")
  incidentDate DateTime
  description  String
  claimNumber  String?
  createdAt    DateTime     @default(now())
  client       Client       @relation(fields: [clientId], references: [id])
  policy       Policy       @relation(fields: [policyId], references: [id])
  events       ClaimEvent[]
}

model ClaimEvent {
  id        String   @id @default(uuid())
  claimId   String
  eventType String
  createdAt DateTime @default(now())
  claim     Claim    @relation(fields: [claimId], references: [id])
}

model IntegrationOperation {
  id        String   @id @default(uuid())
  key       String   @unique
  result    String   // JSON string
  createdAt DateTime @default(now())
}

model Conversation {
  id        String    @id @default(uuid())
  tenantId  String
  clientId  String
  createdAt DateTime  @default(now())
  messages  Message[]
  client    Client    @relation(fields: [clientId], references: [id])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // 'user' | 'assistant'
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}
